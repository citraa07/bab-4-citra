        "# ==========================================================\n",
        "# SISTEM PENJUALAN KOPI NANGGUNG\n",
        "# Mata Kuliah : Algoritma Pemrograman\n",
        "# Studi Kasus : Penjualan Produk Kopi\n",
        "# ==========================================================\n",
        "from datetime import datetime\n",
        "# -----------------------------\n",
        "# Fungsi Judul\n",
        "# -----------------------------\n",
        "def garis():\n",
        "    print(\"=\" * 65)\n",
        "\n",
        "def garis2():\n",
        "    print(\"-\" * 65)\n",
        "\n",
        "# Main program starts here\n",
        "garis()\n",
        "print(\" KOPERASI KOPI NANGGUNG AMANAT\")\n",
        "print(\" Sistem Penjualan Produk Kopi Nusantara\")\n",
        "garis()\n",
        "# -----------------------------\n",
        "# Tanggal Transaksi\n",
        "# -----------------------------\n",
        "tanggal = datetime.now().strftime(\"%d %B %Y\")\n",
        "jam = datetime.now().strftime(\"%H:%M:%S\")\n",
        "print(f\"Tanggal Transaksi : {tanggal}\")\n",
        "print(f\"Jam Transaksi : {jam}\")\n",
        "garis()\n",
        "# -----------------------------\n",
        "# Input Pembeli\n",
        "# -----------------------------\n",
        "nama = input(\"Nama Pembeli : \")\n",
        "print(\"\\nDAFTAR PRODUK KOPI\")\n",
        "garis2()\n",
        "print(\"Kode Produk Harga/kg\")\n",
        "garis2()\n",
        "print(\"GBR Green Bean Robusta Rp 45.000\")\n",
        "print(\"RBR Roasted Bean Robusta Rp 85.000\")\n",
        "print(\"ARB Arabica Premium Rp120.000\")\n",
        "print(\"ESP Espresso Blend Rp140.000\")\n",
        "print(\"DRP Drip Bag Coffee Rp165.000\")\n",
        "garis2()\n",
        "kode = input(\"Masukkan kode produk : \").upper()\n",
        "berat = float(input(\"Masukkan jumlah (kg) : \"))\n",
        "# -----------------------------\n",
        "# Menentukan Produk\n",
        "# -----------------------------\n",
        "if kode == \"GBR\":\n",
        "    produk = \"Green Bean Robusta\"\n",
        "    harga = 45000\n",
        "elif kode == \"RBR\":\n",
        "    produk = \"Roasted Bean Robusta\"\n",
        "    harga = 85000\n",
        "elif kode == \"ARB\":\n",
        "    produk = \"Arabica Premium\"\n",
        "    harga = 120000\n",
        "elif kode == \"ESP\":\n",
        "    produk = \"Espresso Blend\"\n",
        "    harga = 140000\n",
        "elif kode == \"DRP\":\n",
        "    produk = \"Drip Bag Coffee\"\n",
        "    harga = 165000\n",
        "else:\n",
        "    print(\"\\nKode produk tidak tersedia.\")\n",
        "    exit()\n",
        "# -----------------------------\n",
        "# Perhitungan\n",
        "# -----------------------------\n",
        "subtotal = harga * berat\n",
        "# Diskon\n",
        "if subtotal >= 1000000:\n",
        "    diskon = subtotal * 0.10\n",
        "elif subtotal >= 500000:\n",
        "    diskon = subtotal * 0.05\n",
        "else:\n",
        "    diskon = 0\n",
        "# Setelah diskon\n",
        "setelah_diskon = subtotal - diskon\n",
        "# Pajak\n",
        "ppn = setelah_diskon * 0.11\n",
        "# -----------------------------\n",
        "# Ongkir\n",
        "# -----------------------------\n",
        "print(\"\\nKOTA TUJUAN\")\n",
        "print(\"1. Bogor\")\n",
        "print(\"2. Jakarta\")\n",
        "print(\"3. Bandung\")\n",
        "print(\"4. Luar Jawa\")\n",
        "kota_input = input(\"Pilih kota (contoh: Bogor, Jakarta, Bandung, Luar Jawa) : \").lower()\n",
        "if kota_input == \"bogor\":\n",
        "    nama_kota = \"Bogor\"\n",
        "    ongkir = 15000\n",
        "elif kota_input == \"jakarta\":\n",
        "    nama_kota = \"Jakarta\"\n",
        "    ongkir = 25000\n",
        "elif kota_input == \"bandung\":\n",
        "    nama_kota = \"Bandung\"\n",
        "    ongkir = 30000\n",
        "elif kota_input == \"luar jawa\":\n",
        "    nama_kota = \"Luar Jawa\"\n",
        "    ongkir = 60000\n",
        "else:\n",
        "    print(\"Pilihan kota tidak tersedia.\")\n",
        "    exit()\n",
        "# -----------------------------\n",
        "# Bonus\n",
        "# -----------------------------\n",
        "if berat >= 20:\n",
        "    bonus = \"Tumbler Exclusive\"\n",
        "elif berat >= 10:\n",
        "    bonus = \"Mug Kopi\"\n",
        "elif berat >= 5:\n",
        "    bonus = \"Sticker Kopi\"\n",
        "else:\n",
        "    bonus = \"-\"\n",
        "# -----------------------------\n",
        "# Total Bayar\n",
        "# -----------------------------\n",
        "total = setelah_diskon + ppn + ongkir\n",
        "# -----------------------------\n",
        "# Pembayaran\n",
        "# -----------------------------\n",
        "print(\"\\nMetode Pembayaran\")\n",
        "print(\"1. Tunai\")\n",
        "print(\"2. QRIS\")\n",
        "print(\"3. Transfer Bank\")\n",
        "metode_input = input(\"Pilih metode (contoh: Tunai, QRIS, Transfer Bank) : \").lower()\n",
        "if metode_input == \"tunai\":\n",
        "    pembayaran = \"Tunai\"\n",
        "elif metode_input == \"qris\":\n",
        "    pembayaran = \"QRIS\"\n",
        "elif metode_input == \"transfer bank\":\n",
        "    pembayaran = \"Transfer Bank\"\n",
        "else:\n",
        "    print(\"Metode tidak tersedia.\")\n",
        "    exit()\n",
        "print()\n",
        "bayar = float(input(\"Masukkan nominal pembayaran : Rp \"))\n",
        "kembalian = bayar - total\n",
        "# -----------------------------\n",
        "# Status Pembayaran\n",
        "# -----------------------------\n",
        "if bayar >= total:\n",
        "    status = \"LUNAS\"\n",
        "else:\n",
        "    status = \"PEMBAYARAN KURANG\"\n",
        "# -----------------------------\n",
        "# Cetak Struk\n",
        "# -----------------------------\n",
        "print(\"\\n\")\n",
        "garis()\n",
        "print(\" STRUK PENJUALAN\")\n",
        "garis()\n",
        "print(f\"Nama Pembeli : {nama}\")\n",
        "print(f\"Tanggal : {tanggal}\")\n",
        "print(f\"Jam : {jam}\")\n",
        "garis2()\n",
        "print(f\"Produk : {produk}\")\n",
        "print(f\"Kode Produk : {kode}\")\n",
        "print(f\"Berat : {berat:.2f} kg\")\n",
        "print(f\"Harga/kg : Rp {harga:,.0f}\")\n",
        "garis2()\n",
        "print(f\"Subtotal : Rp {subtotal:,.0f}\")\n",
        "print(f\"Diskon : Rp {diskon:,.0f}\")\n",
        "print(f\"PPN (11%) : Rp {ppn:,.0f}\")\n",
        "print(f\"Ongkos Kirim : Rp {ongkir:,.0f}\")\n",
        "garis2()\n",
        "print(f\"TOTAL BAYAR : Rp {total:,.0f}\")\n",
        "print(f\"Pembayaran : {pembayaran}\")\n",
        "print(f\"Uang Dibayar : Rp {bayar:,.0f}\")\n",
        "if bayar >= total:\n",
        "    print(f\"Kembalian : Rp {kembalian:,.0f}\")\n",
        "else:\n",
        "    print(f\"Kekurangan : Rp {abs(kembalian):,.0f}\")\n",
        "print(f\"Status : {status}\")\n",
        "print(f\"Bonus : {bonus}\")\n",
        "print(f\"Kota Tujuan : {nama_kota}\")\n",
        "garis()\n",
        "print(\" Terima kasih telah berbelanja di\")\n",
        "print(\" KOPERASI KOPI NANGGUNG AMANAT\")\n",
        "print(\" Mendukung Kopi Lokal Indonesia\")\n",
        "garis()"
